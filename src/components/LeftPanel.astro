---
// Left Panel: Sticky identity, navigation, and contact bar
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-1/2 lg:flex-col lg:justify-between lg:pt-10 lg:pb-12 py-8">
  <div class="flex flex-col">
    <!-- Profile Image & Status Badge -->
    <div class="flex items-center gap-5 mb-5">
      <div class="relative group">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-teal-400 to-cyan-500 rounded-2xl blur opacity-40 group-hover:opacity-80 transition duration-300"></div>
        <img
          src="/fotoOrla.jpg"
          alt="Fotografía de Emilio Gullón López"
          class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover object-top border-2 border-slate-700/80 shadow-xl"
        />
        <span class="absolute -bottom-1 -right-1 flex h-4 w-4">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-4 w-4 bg-teal-500 border-2 border-slate-900"></span>
        </span>
      </div>

      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-teal-950/60 text-teal-300 border border-teal-800/60 mb-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
          Disponible para incorporación
        </div>
        <p class="text-xs text-slate-400 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          Granada, España
        </p>
      </div>
    </div>

    <!-- Name and Titles -->
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-100">
      <a href="/" class="hover:text-teal-300 transition-colors">Emilio Gullón</a>
    </h1>
    
    <h2 class="mt-3 text-base sm:text-lg font-medium text-teal-400 font-mono tracking-tight leading-snug">
      Ingeniero de Software e Inteligencia Artificial
    </h2>
    <p class="text-xs sm:text-sm font-mono text-slate-400 mt-1">
      Python · PyTorch · Deep Learning · Data Pipelines
    </p>

    <!-- Bio / Value Proposition -->
    <p class="mt-5 max-w-sm text-sm sm:text-base leading-relaxed text-slate-400">
      Especializado en la convergencia entre software robusto, arquitecturas de <span class="text-slate-200 font-medium">Deep Learning</span> y canalizaciones analíticas reproducibles. Graduado en Ingeniería Informática por la Universidad de Granada, con foco en sistemas predictivos y despliegue eficiente en producción.
    </p>

    <!-- CV Download Button -->
    <div class="mt-6 flex flex-wrap items-center gap-2.5">
      <a
        href="/curriculum_emilio_gullon.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-teal-500/10 hover:bg-teal-500/20 text-teal-300 hover:text-teal-200 border border-teal-500/30 text-xs sm:text-sm font-mono font-medium transition-all shadow-sm hover:shadow-teal-500/10"
      >
        <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        Descargar CV (PDF)
      </a>

      <a
        href="/curriculum_emilio_gullon_en.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-lg bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 hover:text-teal-300 border border-slate-700 text-xs font-mono font-medium transition-all"
        title="Descargar CV en inglés (English version)"
      >
        <span>CV (EN)</span>
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>

      <button
        id="copy-email-btn"
        class="inline-flex items-center gap-2 px-3 py-2.5 rounded-lg bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 hover:text-white border border-slate-700 text-xs font-mono transition-all"
        title="Copiar email al portapapeles"
        data-email="egullonl01@gmail.com"
      >
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        <span id="copy-email-text">Copiar Email</span>
      </button>
    </div>

    <!-- Navigation Menu (Desktop Sticky) -->
    <nav class="nav hidden lg:block mt-7" aria-label="Navegación en la página">
      <ul class="flex flex-col gap-4 font-mono text-xs tracking-wider uppercase">
        <li>
          <a class="nav-link group flex items-center py-1 text-slate-400 hover:text-slate-100 transition-colors" href="#sobre-mi">
            <span class="nav-indicator mr-4 h-px w-8 bg-slate-600 transition-all group-hover:w-16 group-hover:bg-slate-200"></span>
            <span class="nav-text text-xs font-bold tracking-widest text-slate-400 group-hover:text-slate-200">01 // SOBRE MÍ</span>
          </a>
        </li>
        <li>
          <a class="nav-link group flex items-center py-1 text-slate-400 hover:text-slate-100 transition-colors" href="#proyecto-tfg">
            <span class="nav-indicator mr-4 h-px w-8 bg-slate-600 transition-all group-hover:w-16 group-hover:bg-slate-200"></span>
            <span class="nav-text text-xs font-bold tracking-widest text-slate-400 group-hover:text-slate-200">02 // PROYECTO TFG (9.8/10)</span>
          </a>
        </li>
        <li>
          <a class="nav-link group flex items-center py-1 text-slate-400 hover:text-slate-100 transition-colors" href="#educacion">
            <span class="nav-indicator mr-4 h-px w-8 bg-slate-600 transition-all group-hover:w-16 group-hover:bg-slate-200"></span>
            <span class="nav-text text-xs font-bold tracking-widest text-slate-400 group-hover:text-slate-200">03 // FORMACIÓN</span>
          </a>
        </li>
        <li>
          <a class="nav-link group flex items-center py-1 text-slate-400 hover:text-slate-100 transition-colors" href="#habilidades">
            <span class="nav-indicator mr-4 h-px w-8 bg-slate-600 transition-all group-hover:w-16 group-hover:bg-slate-200"></span>
            <span class="nav-text text-xs font-bold tracking-widest text-slate-400 group-hover:text-slate-200">04 // COMPETENCIAS</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Social Links & Direct Mail -->
  <div class="mt-8 lg:mt-0 pt-6 border-t border-slate-800/60 lg:border-t-0 flex flex-col gap-3">
    <div class="flex items-center gap-5 text-slate-400">
      <!-- GitHub -->
      <a
        href="https://github.com/EmilioGullon"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-teal-300 transition-colors"
        aria-label="Perfil de GitHub de Emilio Gullón (se abre en nueva pestaña)"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://linkedin.com/in/emilio-gullón-lópez-1b7211412"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-teal-300 transition-colors"
        aria-label="Perfil de LinkedIn de Emilio Gullón (se abre en nueva pestaña)"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>

      <!-- Mailto Link -->
      <a
        href="mailto:egullonl01@gmail.com"
        class="hover:text-teal-300 transition-colors"
        aria-label="Enviar correo a egullonl01@gmail.com"
      >
        <svg class="w-6 h-6 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </a>
    </div>

    <a href="mailto:egullonl01@gmail.com" class="font-mono text-xs text-slate-400 hover:text-teal-300 transition-colors">
      egullonl01@gmail.com
    </a>
  </div>
</header>

<script>
  // Copy email interactive button
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-email-text');
  
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'egullonl01@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        copyText.textContent = '¡Copiado!';
        copyBtn.classList.add('border-teal-400', 'text-teal-300');
        setTimeout(() => {
          copyText.textContent = 'Copiar Email';
          copyBtn.classList.remove('border-teal-400', 'text-teal-300');
        }, 2000);
      } catch (err) {
        console.error('Error al copiar email:', err);
      }
    });
  }

  // Active section scrollspy
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  function highlightNav() {
    let scrollPosition = window.scrollY + 180;

    sections.forEach((section) => {
      const el = section as HTMLElement;
      const top = el.offsetTop;
      const height = el.offsetHeight;
      const id = el.getAttribute('id');

      if (scrollPosition >= top && scrollPosition < top + height) {
        navLinks.forEach((link) => {
          link.classList.remove('active');
          if (link.getAttribute('href') === `#${id}`) {
            link.classList.add('active');
          }
        });
      }
    });
  }

  window.addEventListener('scroll', highlightNav, { passive: true });
  highlightNav();
</script>
