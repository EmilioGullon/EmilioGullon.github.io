---
// Section 04: Competencias Técnicas y Habilidades
---

<section id="habilidades" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-32 lg:scroll-mt-24" aria-label="Habilidades técnicas">
  <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-slate-900/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
    <h2 class="text-sm font-bold font-mono uppercase tracking-widest text-slate-200 lg:sr-only">
      04 // Competencias Técnicas
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    
    <!-- Categoría 1: Lenguajes -->
    <div class="glass-card rounded-xl p-5 border border-slate-800">
      <h3 class="text-xs font-mono uppercase tracking-wider text-teal-300 font-semibold mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
        </svg>
        Lenguajes de Programación
      </h3>
      <div class="flex flex-wrap gap-1.5">
        <span class="rounded bg-teal-950/60 px-2.5 py-1 font-mono text-xs text-teal-300 border border-teal-800/60 font-semibold">Python</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">SQL</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">C++</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Java</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">C#</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">JavaScript</span>
      </div>
    </div>

    <!-- Categoría 2: Deep Learning & IA -->
    <div class="glass-card rounded-xl p-5 border border-slate-800">
      <h3 class="text-xs font-mono uppercase tracking-wider text-teal-300 font-semibold mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Deep Learning & Modelado IA
      </h3>
      <div class="flex flex-wrap gap-1.5">
        <span class="rounded bg-teal-950/60 px-2.5 py-1 font-mono text-xs text-teal-300 border border-teal-800/60 font-semibold">PyTorch</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">TensorFlow</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">xLSTM / GRU</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Transformers</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Optuna (Bayesiano)</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Scikit-learn</span>
      </div>
    </div>

    <!-- Categoría 3: Ciencia de Datos & Visión -->
    <div class="glass-card rounded-xl p-5 border border-slate-800">
      <h3 class="text-xs font-mono uppercase tracking-wider text-teal-300 font-semibold mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        Ciencia de Datos & Visión
      </h3>
      <div class="flex flex-wrap gap-1.5">
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">NumPy</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Pandas</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Matplotlib</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">OpenCV</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Series Temporales</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Ingesta Multimodal</span>
      </div>
    </div>

    <!-- Categoría 4: Software, Plataformas & Metodologías -->
    <div class="glass-card rounded-xl p-5 border border-slate-800">
      <h3 class="text-xs font-mono uppercase tracking-wider text-teal-300 font-semibold mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
        Software, Plataformas & DevOps
      </h3>
      <div class="flex flex-wrap gap-1.5">
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Django (MVC)</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Docker</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Git & GitHub</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Linux</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Edge AI</span>
        <span class="rounded bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-300 border border-slate-700/60">Clean Architecture</span>
      </div>
    </div>

  </div>

  <!-- Barra de Idiomas -->
  <div class="mt-6 glass-card rounded-xl p-4 border border-slate-800 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
    <span class="text-slate-400 uppercase tracking-wider">Idiomas:</span>
    <div class="flex flex-wrap items-center gap-4 text-slate-300">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-teal-400"></span>
        Español: <strong class="text-slate-100 font-semibold">Nativo</strong>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        Inglés: <strong class="text-slate-100 font-semibold">B2 (En curso)</strong>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-slate-500"></span>
        Portugués: <strong class="text-slate-100 font-semibold">Básico</strong>
      </span>
    </div>
  </div>

  <!-- Pie de sección / Créditos técnicos -->
  <footer class="mt-16 pt-8 border-t border-slate-800/80 text-xs font-mono text-slate-400">
    <p>
      Construido con <span class="text-teal-300">Astro</span> y <span class="text-teal-300">Tailwind CSS</span>.
    </p>
  </footer>
</section>
