---
// Interactive mouse spotlight effect following the cursor
---

<div
  id="pointer-glow"
  class="pointer-events-none fixed inset-0 z-30 transition duration-300 hidden lg:block"
  style="background: radial-gradient(600px circle at var(--mouse-x, 0px) var(--mouse-y, 0px), rgba(45, 212, 191, 0.06), transparent 80%);"
  aria-hidden="true"
></div>

<script>
  const glow = document.getElementById('pointer-glow');
  if (glow) {
    window.addEventListener('mousemove', (e) => {
      glow.style.setProperty('--mouse-x', `${e.clientX}px`);
      glow.style.setProperty('--mouse-y', `${e.clientY}px`);
    });
  }
</script>
