---
import SpotlightEffect from '../components/SpotlightEffect.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Emilio Gullón López | Ingeniero de Software e Inteligencia Artificial",
  description = "Portafolio técnico de Emilio Gullón López. Ingeniero de Software e Inteligencia Artificial especializado en Deep Learning, PyTorch, series temporales, canalizaciones de datos y optimización Edge AI.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Emilio Gullón López" />
    <meta name="theme-color" content="#0F172A" />

    <!-- Open Graph / Meta Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/fotoOrla.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/fotoOrla.jpg" />

    <!-- Favicon SVG -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='25' fill='%230F172A'/><text x='50%' y='58%' dominant-baseline='middle' text-anchor='middle' font-family='monospace' font-size='42' font-weight='bold' fill='%232DD4BF'>EG</text></svg>" />

    <!-- Google Fonts Preconnect: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="bg-[#0F172A] leading-relaxed text-slate-400 selection:bg-teal-300 selection:text-teal-900 relative">
    <SpotlightEffect />
    <div class="relative z-10 mx-auto min-h-screen max-w-screen-xl px-6 py-8 md:px-12 md:py-16 lg:px-24 lg:py-0">
      <slot />
    </div>
  </body>
</html>
